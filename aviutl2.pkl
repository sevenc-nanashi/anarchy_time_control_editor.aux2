// 設定ファイルについては https://github.com/sevenc-nanashi/aviutl2-cli を参照してください。
amends "https://raw.githubusercontent.com/sevenc-nanashi/aviutl2-cli/refs/tags/0.11.0/src/AviUtl2CliConfig.pkl"

project {
  id = "sevenc-nanashi.anarchy_time_control_editor-aux2"
  name = "anarchy_time_control_editor.aux2"
  version = "0.1.0"
}

development {
  aviutl2_version = "latest"
  catalog_dependencies = List("KuroNeko.CopyAlias", "sigma-axis.Basic_S", "aviutl2-community.aviutl2_community_translation_companion")
}

release {
  prebuild = "cargo about generate -o release/package.txt about.hbs"
  package_template = "release/package.txt"
}

artifacts {
  ["anarchy_time_control_editor-aux2"] {
    destination = "Plugin/anarchy_time_control_editor.aux2"
    profiles {
      ["debug"] {
        build = "cargo build"
        source = "target/debug/anarchy_time_control_editor_aux2.dll"
      }
      ["release"] {
        build = "cargo build --release"
        source = "target/release/anarchy_time_control_editor_aux2.dll"
      }
    }
  }
  ["Default-anarchy_time_control_editor-aux2-aul2"] {
    destination = "Language/Default.anarchy_time_control_editor-aux2.aul2"
    source = "i18n/Default.aul2"
  }
  ["English-anarchy_time_control_editor-aux2-aul2"] {
    destination = "Language/English.anarchy_time_control_editor-aux2.aul2"
    source = "i18n/English.aul2"
  }
}

catalog {
  id = "sevenc-nanashi.anarchy_time_control_editor-aux2"
  download_repo {
    owner = "sevenc-nanashi"
    repo = "anarchy_time_control_editor.aux2"
  }
  license_path = "./LICENSE"
}
